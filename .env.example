# ---------------------------------------------------------------------------
# Libercus Playwright — environment template. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real credentials (the Selenium project
# committed them in LoginDetails.yml — we do not repeat that here).
# ---------------------------------------------------------------------------

# CMS login credentials (Selenium: data/LoginDetails.yml)
LIBERCUS_USERNAME=your-cms-username
LIBERCUS_PASSWORD=your-cms-password

# Customer environment for DATA selection (channels/shapes) and URL routing.
# PG | TB. Selenium: PROJECT_ENV (defaults: PG for data, TB for URL routing).
PROJECT_ENV=PG

# --- Optional base-URL overrides (defaults are baked into utils/env.ts) ------
# Per customer + surface:
# BASE_URL_PG_CMS=https://pgmuatedit.libercus.net/admin
# BASE_URL_PG_PF3=https://pgmuate-edition.libercus.net/pf3/
# BASE_URL_PG_PF3ADMIN=https://tbqapf3admin.libercus.net/pf3admin
# BASE_URL_TB_CMS=https://tbmuatedit.libercus.net/admin
# BASE_URL_TB_PF3=https://tbmuate-edition.libercus.net/pf3/
# BASE_URL_TB_PF3ADMIN=https://pgmuat-pf3manage.libercus.net/pf3admin

# Run browsers headed locally (CI is always headless): HEADLESS=false
# HEADLESS=false
